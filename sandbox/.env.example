# Copy to .env.local (gitignored) and fill in. The orchestrator auto-loads
# sandbox/.env.local; values already set in the shell take precedence.

# --- Revyl ------------------------------------------------------------------
# API key: app.revyl.ai -> Settings -> API keys (or ~/.revyl/credentials.json
# after `revyl auth login`).
REVYL_API_KEY=

# Org id: printed by `revyl auth status`.
REVYL_ORG_ID=

# iOS app slot id: `revyl app list --json`, or create one with
# `revyl app create --name "revyl-swift-demo" --platform ios --json`.
REVYL_APP_ID=

# Build runner image. Required while the default runner Xcode is newer than
# the repo's .xcode-version pin (26.2); list of images: `revyl build --help`.
REVYL_BUILD_IMAGE=ios-macos-26-xcode-26.2

# --- Vercel -----------------------------------------------------------------
# Access token: vercel.com -> Account Settings -> Tokens.
VERCEL_TOKEN=

# Team id (team_...): Vercel dashboard -> Team Settings -> General, or
#   curl -s -H "Authorization: Bearer $VERCEL_TOKEN" https://api.vercel.com/v2/teams
VERCEL_TEAM_ID=

# Project id (prj_...): any project in the team; Project Settings -> General, or
#   curl -s -H "Authorization: Bearer $VERCEL_TOKEN" "https://api.vercel.com/v9/projects?teamId=$VERCEL_TEAM_ID"
VERCEL_PROJECT_ID=

# Alternative to the three values above: run `vercel link && vercel env pull`
# in a linked project and export VERCEL_OIDC_TOKEN instead (expires after 12h).
# VERCEL_OIDC_TOKEN=

# --- Optional ---------------------------------------------------------------
# Branch/tag/sha the sandbox clones (defaults to main).
# SANDBOX_GIT_REVISION=main

# Keep the Revyl device session running after the proof for manual viewing.
# Stop it yourself afterward with `revyl device stop -s 0`.
# KEEP_DEVICE_SESSION=1
